{
  "manifest_version": 3,
  "name": "dwn",
  "version": "0.1.0",
  "key": "",
  "description": "Download video and audio from the current tab.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "minimum_chrome_version": "116",

  "permissions": [
    "nativeMessaging",
    "cookies",
    "storage",
    "tabs",
    "sidePanel"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.tiktok.com/*",
    "*://*.instagram.com/*",
    "*://*.reddit.com/*"
  ],

  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.reddit.com/*"
      ],
      "js": ["content/floating.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["ui/sidepanel.html"],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.reddit.com/*"
      ]
    }
  ],

  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },

  "action": {
    "default_title": "Open dwn on this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}